<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.kinetica</groupId>
  <artifactId>apache-beam-kineticaio</artifactId>
  <version>7.2.0.0</version>
  <description>IO to read and write with Kinetica database</description>

  <properties>
    <beam.version>2.41.0</beam.version>
    <jackson.version>2.22.1</jackson.version>
    <!-- These three are held at the highest version any dependency asks for, so
         the requireUpperBoundDeps enforcer rule below passes. slf4j-api 2.0.x and
         logback-classic 1.3.x belong together: logback 1.2.x implements the older
         slf4j 1.7 service SPI and is not a valid provider for slf4j 2.x. -->
    <slf4j.version>2.0.17</slf4j.version>
    <logback.version>1.3.16</logback.version>
    <commons.compress.version>1.28.0</commons.compress.version>
    <commons.codec.version>1.19.0</commons.codec.version>
    <error.prone.annotations.version>2.11.0</error.prone.annotations.version>
    <argLine>-DbeamTestPipelineOptions='["--kineticaURL=http://kinetica:9191", "--kineticaUsername=admin", "--kineticaPassword=admin", "--kineticaTable=scientists", "--runner=DirectRunner"]'</argLine>
    <maven.test.skip>true</maven.test.skip>
  </properties>

  <!-- Forces one coherent Jackson version across gpudb-api, Beam and Avro.
       Deliberately equal to the pin gpudb-api 7.2.3.22 applies internally, so
       this block agrees with the API rather than overriding it.

       MAINTENANCE: keep this in step with gpudb-api's own Jackson pin (its
       kinetica.jackson.version property) and never lower it. gpudb-api chose
       2.22.1 as the earliest release with no outstanding advisory against
       jackson-core/-databind/-annotations, clearing GHSA-72hv-8253-57qq and the
       HIGH follow-up GHSA-r7wm-3cxj-wff9. A project's own dependencyManagement
       outranks management imported from a dependency, so a value lower than the
       API's would silently reintroduce those advisories.

       Why keep this at all, now that the API pins Jackson itself: without it,
       the resolved version depends on the order of the dependencies below.
       gpudb-api and beam-sdks-java-core both contribute Jackson at depth 2, and
       Beam asks for 2.13.0; with gpudb-api declared first the tie resolves to
       2.22.1, but reordering the two silently drops all of Jackson to 2.13.0.
       This block makes the outcome order-independent. It is also what makes
       gpudb-api 7.2.3.21 and earlier usable at all: those pin
       jackson-core/-databind but not jackson-annotations, which then resolves to
       Beam's 2.13.0 and fails at runtime with NoSuchFieldError:
       READ_UNKNOWN_ENUM_VALUES_USING_DEFAULT_VALUE, a JsonFormat.Feature
       constant added in annotations 2.15. -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Raised to the highest version requested anywhere in the graph; see the
           property comments above. Without these, our own declarations and Beam's
           pull these artifacts *below* what gpudb-api and Avro ask for. -->
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons.compress.version}</version>
      </dependency>
      <dependency>
        <groupId>commons-codec</groupId>
        <artifactId>commons-codec</artifactId>
        <version>${commons.codec.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>${error.prone.annotations.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>runTests</id>
      <properties>
        <maven.test.skip>false</maven.test.skip>
      </properties>
    </profile>
  </profiles>

  <dependencies>
  	<dependency>
  		<groupId>com.gpudb</groupId>
  		<artifactId>gpudb-api</artifactId>
  		<!-- Floor is 7.2.3.22: it is the first release to pin Jackson coherently
  		     (see the dependencyManagement note above). Java 11 has been required
  		     since 7.2.3.7. -->
  		<version>[7.2.3.22,7.3.0.0-SNAPSHOT)</version>
  	</dependency>
    <dependency>
      <groupId>org.apache.beam</groupId>
      <artifactId>beam-sdks-java-core</artifactId>
      <version>${beam.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
	  <version>${slf4j.version}</version>
    </dependency>
	<dependency>
	  <groupId>ch.qos.logback</groupId>
	  <artifactId>logback-classic</artifactId>
	  <version>${logback.version}</version>
	</dependency>
	<dependency>
	  <groupId>com.google.auto.value</groupId>
	  <artifactId>auto-value-annotations</artifactId>
	  <version>1.9</version>
	</dependency>
	<dependency>
	  <groupId>com.google.auto.value</groupId>
	  <artifactId>auto-value</artifactId>
	  <version>1.9</version>
	</dependency>
	<dependency>
	    <groupId>com.google.guava</groupId>
	    <artifactId>guava</artifactId>
	    <version>31.1-jre</version>
	</dependency>
	<dependency>
	    <groupId>com.google.code.findbugs</groupId>
	    <artifactId>jsr305</artifactId>
	    <version>3.0.2</version>
	</dependency>
	<dependency>
	    <groupId>org.apache.beam</groupId>
	    <artifactId>beam-sdks-java-core</artifactId>
	    <version>${beam.version}</version>
	    <type>pom</type>
	</dependency>
    <!-- test dependencies -->
    <dependency>
      <groupId>org.apache.beam</groupId>
      <artifactId>beam-runners-direct-java</artifactId>
      <version>${beam.version}</version>
      <scope>test</scope>
    </dependency>
	<dependency>
	    <groupId>org.apache.beam</groupId>
	    <artifactId>beam-sdks-java-io-common</artifactId>
	    <version>${beam.version}</version>
	    <type>pom</type>
	    <scope>test</scope>
	</dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest-core</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.hamcrest</groupId>
      <artifactId>hamcrest-library</artifactId>
      <version>2.2</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>4.7.0</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.beam</groupId>
      <artifactId>beam-sdks-java-io-common</artifactId>
	  <version>${beam.version}</version>
      <scope>test</scope>
      <classifier>tests</classifier>
    </dependency>
  </dependencies>
  <build>
    <plugins>
		<plugin>
		  <groupId>org.apache.maven.plugins</groupId>
		  <artifactId>maven-enforcer-plugin</artifactId>
		  <version>3.5.0</version>
		  <!-- Fails the build if any dependency is resolved *below* a version
		       something else in the graph asks for. This is the guard for the Jackson
		       pin above: if gpudb-api later raises its Jackson version past ours, or a
		       dependency reorder drops Jackson to Beam's 2.13.0, the build stops here
		       instead of silently shipping a downgrade. -->
		  <executions>
		    <execution>
		      <id>enforce-no-downgrades</id>
		      <goals>
		        <goal>enforce</goal>
		      </goals>
		      <configuration>
		        <rules>
		          <requireUpperBoundDeps>
		            <!-- Scoped to the artifacts this POM deliberately manages. The rule
		                 is not applied graph-wide on purpose: Beam's own transitive
		                 tree (protobuf, google-api-client, hadoop, gson ...) carries
		                 dozens of internal downgrades that are not ours to arbitrate,
		                 and failing on those would mean pinning Beam's internals. -->
		            <includes>
		              <include>com.fasterxml.jackson.core:jackson-core</include>
		              <include>com.fasterxml.jackson.core:jackson-databind</include>
		              <include>com.fasterxml.jackson.core:jackson-annotations</include>
		              <include>org.slf4j:slf4j-api</include>
		              <include>ch.qos.logback:logback-classic</include>
		              <include>org.apache.commons:commons-compress</include>
		              <include>commons-codec:commons-codec</include>
		              <include>com.google.errorprone:error_prone_annotations</include>
		            </includes>
		          </requireUpperBoundDeps>
		        </rules>
		      </configuration>
		    </execution>
		  </executions>
		</plugin>
		<plugin>
		  <artifactId>maven-compiler-plugin</artifactId>
		  <version>3.7.0</version>
		  <configuration>
		    <!-- Java 11 is the floor: gpudb-api is compiled for Java 11 as of
		         7.2.3.7 (7.2.3.6 was the last Java 8 build), and the version
		         range above always resolves to the newest available. -->
		    <source>11</source>
		    <target>11</target>
		  </configuration>
		</plugin>
		<plugin>
		  <groupId>org.codehaus.mojo</groupId>
		  <artifactId>build-helper-maven-plugin</artifactId>
		  <version>1.12</version>
		  <executions>
		    <execution>
		      <id>add-test-resource</id>
		      <phase>generate-test-sources</phase>
		      <goals>
		        <goal>add-test-resource</goal>
		      </goals>
		      <configuration>
		        <resources>
		          <resource>
		            <directory>resources</directory>
		          </resource>
		        </resources>
		      </configuration>
		    </execution>
		  </executions>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<version>2.22.0</version>
			<configuration>
            	<useManifestOnlyJar>false</useManifestOnlyJar>
            	<trimStackTrace>false</trimStackTrace>
            	<argLine>${argLine}</argLine>
          	</configuration>
			<executions>
          		<execution>
            		<phase>integration-test</phase>
            		<goals>
              			<goal>test</goal>
		            </goals>
		            <configuration>
		            	<skipTests>false</skipTests>
		            </configuration>
        		</execution>
        	</executions>
          	<dependencies>
	            <dependency>
	              <groupId>org.apache.maven.surefire</groupId>
	              <artifactId>surefire-junit47</artifactId>
	              <version>2.22.0</version>
	            </dependency>
			</dependencies>
		</plugin>
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-failsafe-plugin</artifactId>
			<version>2.22.0</version>
			<configuration>
            	<skipTests>true</skipTests>
          	</configuration>
			<executions>
          		<execution>
            		<goals>
              			<goal>integration-test</goal>
			            <goal>verify</goal>
		            </goals>
	        		<configuration>
		        		<includes>
							 <include>**/IT_*.java</include>
							</includes>
	        		</configuration>
        		</execution>
        	</executions>
        	<dependencies>
        		<dependency>
		      		<groupId>junit</groupId>
		      		<artifactId>junit</artifactId>
		      		<version>4.11</version>
		    	</dependency>
	    	</dependencies>
  		</plugin>

    </plugins>
  </build>
</project>
